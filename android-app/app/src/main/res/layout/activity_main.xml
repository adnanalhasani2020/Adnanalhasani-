<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F3F7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp" android:background="#145DA8">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="☰     العيادة العامة                         🔔"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="د. أحمد العسيري"
            android:textColor="#E5F1FF" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:background="#FFFFFF" android:orientation="horizontal">
        <Button android:id="@+id/tabToday" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="المرضى اليوم" android:textSize="12sp"/>
        <Button android:id="@+id/tabUpcoming" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="المواعيد القادمة" android:textSize="12sp"/>
        <Button android:id="@+id/tabCompleted" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="المنتهية" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <Button android:id="@+id/dateButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📅  اختيار التاريخ"/>
        <EditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:singleLine="true" android:hint="ابحث باسم المريض أو رقم الملف"
            android:inputType="text"/>
        <TextView android:id="@+id/listTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="8dp" android:text="المرضى المنتظرون"
            android:textColor="#123E78" android:textStyle="bold" android:textSize="17sp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/patientList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp"
            android:paddingEnd="12dp" android:paddingBottom="12dp"/>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="♙\nالمرضى" android:textColor="#145DA8"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="▦\nالمواعيد" android:textColor="#66788A"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="▥\nالإحصائيات" android:textColor="#66788A"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="•••\nالمزيد" android:textColor="#66788A"/>
    </LinearLayout>
</LinearLayout>
